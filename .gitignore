# Virtual environment
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Local settings and runtime files
settings.json
debug.log
*.log
# applog uses RotatingFileHandler(backupCount=2), which appends a numeric
# suffix: debug.log.1 / debug.log.2. Those match neither pattern above,
# so rotated logs showed up as untracked files.
*.log.[0-9]

# Models (downloaded at runtime, large)
models/
*.bin
*.onnx

# Temp / TTS cache
*.mp3
*.wav

# IDE / agent tooling
.vscode/
.idea/
.agents/
.codex/
*.swp

# OS
Thumbs.db
.DS_Store
desktop.ini
crash.log
settings.json.*.bak

# local dictation metrics (privacy-safe, never uploaded)
metrics.jsonl
metrics.jsonl.1

# archived diagnostic logs (local only)
*.archive
settings.json.corrupt.bak
